<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanzasApp.UI.Views.ObjetivosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FinanzasApp.UI.ViewModels"
    xmlns:dto="clr-namespace:FinanzasApp.Core.DTOs.Objetivo;assembly=Core"
    x:DataType="vm:ObjetivosViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout
            Grid.Row="0"
            BackgroundColor="{StaticResource Primary}">
            <VerticalStackLayout.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="24,48,24,20" />
                    <On Platform="WinUI" Value="24,16,24,20" />
                </OnPlatform>
            </VerticalStackLayout.Padding>
            <Label
                Text="Objetivos"
                FontSize="24" FontAttributes="Bold"
                TextColor="{StaticResource White}" />
        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            Command="{Binding CargarObjetivosCommand}"
            IsRefreshing="{Binding EstaCargando}">

            <CollectionView
                ItemsSource="{Binding Objetivos}"
                SelectionMode="None"
                Margin="16,8">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ObjetivoConProgresoDto">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ObjetivosViewModel}}, Path=VerDetalleCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label
                                            Text="{Binding Descripcion}"
                                            FontSize="15" FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding TipoNombre}"
                                            Style="{StaticResource LabelSecundario}" />
                                    </VerticalStackLayout>

                                    <!-- Badge de estado -->
                                    <Border
                                        Grid.Column="1"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8,4"
                                        VerticalOptions="Start"
                                        BackgroundColor="{Binding SeHaCumplido,
                                            Converter={StaticResource EsIngresoActivoConverter}}">
                                        <Label
                                            Text="{Binding Estado}"
                                            FontSize="11" FontAttributes="Bold"
                                            TextColor="{StaticResource White}" />
                                    </Border>
                                </Grid>

                                <!-- Barra de progreso -->
                                <VerticalStackLayout Spacing="4">
                                    <ProgressBar
                                        Progress="{Binding Progreso}"
                                        HeightRequest="8"
                                        ProgressColor="{Binding EstaEnPeligro,
                                            Converter={StaticResource EsGastoActivoConverter}}" />
                                    <Label
                                        Text="{Binding TextoProgreso}"
                                        Style="{StaticResource LabelSecundario}"
                                        FontSize="12" />
                                </VerticalStackLayout>

                                <!-- Fechas y advertencia de vencido -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="11"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FechaInicio,
                                                    StringFormat='{0:dd/MM/yy}'}" />
                                                <Span Text=" → " />
                                                <Span Text="{Binding FechaFin,
                                                    StringFormat='{0:dd/MM/yy}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label
                                        Grid.Column="1"
                                        Text="⚠️ Vencido"
                                        FontSize="11"
                                        TextColor="{StaticResource Advertencia}"
                                        IsVisible="{Binding EstaVencido}" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" Padding="0,48">
                        <Label Text="🎯" FontSize="48" HorizontalOptions="Center" />
                        <Label
                            Text="No tienes objetivos aún"
                            Style="{StaticResource LabelSecundario}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>

        <Button
            Grid.Row="1"
            Text="+"
            Style="{StaticResource FabButton}"
            Command="{Binding CrearObjetivoCommand}"
            HorizontalOptions="End"
            VerticalOptions="End">
            <Button.Margin>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="0,0,16,80" />
                    <On Platform="WinUI" Value="0,0,16,16" />
                </OnPlatform>
            </Button.Margin>
        </Button>

    </Grid>
</ContentPage>