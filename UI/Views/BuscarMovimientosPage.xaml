<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanzasApp.UI.Views.BuscarMovimientosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FinanzasApp.UI.ViewModels"
    xmlns:dto="clr-namespace:FinanzasApp.Core.DTOs.Movimiento;assembly=Core"
    x:DataType="vm:BuscarMovimientosViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Cabecera -->
        <VerticalStackLayout
            Grid.Row="0"
            BackgroundColor="{StaticResource Primary}">
            <VerticalStackLayout.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="16,48,16,16" />
                    <On Platform="WinUI" Value="16,16,16,16" />
                </OnPlatform>
            </VerticalStackLayout.Padding>

            <Grid ColumnDefinitions="Auto,*">
                <Button
                    Grid.Column="0"
                    Text="←"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource White}"
                    Command="{Binding VolverCommand}" />
                <Label
                    Grid.Column="1"
                    Text="Buscar Movimientos"
                    FontSize="22" FontAttributes="Bold"
                    TextColor="{StaticResource White}"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <!-- Buscador -->
        <Border
            Grid.Row="1"
            Margin="16,12"
            StrokeThickness="1.5"
            Stroke="{StaticResource Gray200}"
            StrokeShape="RoundRectangle 12"
            Padding="12,0"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label
                    Grid.Column="0"
                    Text="🔍" FontSize="16"
                    VerticalOptions="Center"
                    Margin="0,0,8,0" />
                <Entry
                    Grid.Column="1"
                    Style="{StaticResource FormEntry}"
                    Placeholder="Buscar por nombre, descripción..."
                    Text="{Binding TextoBusqueda}"
                    ClearButtonVisibility="WhileEditing"
                    ReturnCommand="{Binding BuscarCommand}" />
                <!-- Limpiar filtros -->
                <Button
                    Grid.Column="2"
                    Text="✕"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Gasto}"
                    IsVisible="{Binding HayFiltrosActivos}"
                    Command="{Binding LimpiarFiltrosCommand}"
                    Padding="4,0" />
            </Grid>
        </Border>

        <!-- Filtros -->
        <ScrollView
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalScrollBarVisibility="Never"
            Margin="16,0,16,8">
            <HorizontalStackLayout Spacing="8">

                <!-- Filtro mes -->
                <Border
                    StrokeThickness="1.5"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 20"
                    Padding="12,6"
                    BackgroundColor="{StaticResource PrimaryLight}">
                    <Label
                        Text="{Binding MesAnioTexto}"
                        FontSize="13"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"/>
                </Border>

                <!-- Chips de tipo -->
                <Border
                    StrokeThickness="1.5"
                    Stroke="{StaticResource Gray200}"
                    StrokeShape="RoundRectangle 20"
                    Padding="12,6"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SeleccionarTipoCommand}"
                            CommandParameter="Todos" />
                    </Border.GestureRecognizers>
                    <Label Text="Todos" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </Border>

                <Border
                    StrokeThickness="1.5"
                    Stroke="{StaticResource Ingreso}"
                    StrokeShape="RoundRectangle 20"
                    Padding="12,6"
                    BackgroundColor="{StaticResource IngresoLight}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SeleccionarTipoCommand}"
                            CommandParameter="Ingreso" />
                    </Border.GestureRecognizers>
                    <Label Text="🟢 Ingresos" FontSize="14" TextColor="{StaticResource Ingreso}" />
                </Border>

                <Border
                    StrokeThickness="1.5"
                    Stroke="{StaticResource Gasto}"
                    StrokeShape="RoundRectangle 20"
                    Padding="12,6"
                    BackgroundColor="{StaticResource GastoLight}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SeleccionarTipoCommand}"
                            CommandParameter="Gasto" />
                    </Border.GestureRecognizers>
                    <Label Text="🔴 Gastos" FontSize="14" TextColor="{StaticResource Gasto}" />
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Resultados -->
        <RefreshView
            Grid.Row="3"
            Command="{Binding BuscarCommand}"
            IsRefreshing="{Binding EstaCargando}">

            <CollectionView
                ItemsSource="{Binding Resultados}"
                SelectionMode="None"
                Margin="16,0">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:MovimientoDto">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BuscarMovimientosViewModel}}, Path=VerDetalleCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 22"
                                    BackgroundColor="{Binding Tipo, Converter={StaticResource TipoToColorConverter}}">
                                    <Label
                                        Text="{Binding Tipo, Converter={StaticResource TipoToEmojiConverter}}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="15" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Text="{Binding CategoriaNombre, TargetNullValue='Sin categoría'}"
                                        Style="{StaticResource LabelSecundario}" />
                                    <Label
                                        Text="{Binding Fecha, StringFormat='{0:dd MMM yyyy}'}"
                                        Style="{StaticResource LabelSecundario}"
                                        FontSize="11" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Cantidad, StringFormat='{0:C2}'}"
                                    VerticalOptions="Center"
                                    FontAttributes="Bold" FontSize="15"
                                    TextColor="{Binding Tipo, Converter={StaticResource TipoToTextColorConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" Padding="0,48">
                        <Label Text="🔍" FontSize="50" HorizontalOptions="Center" />
                        <Label
                            Text="No se encontro ningún movimientos"
                            Style="{StaticResource LabelSecundario}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>