<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanzasApp.UI.Views.NotificacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FinanzasApp.UI.ViewModels"
    xmlns:dto="clr-namespace:FinanzasApp.Core.DTOs.Notificacion;assembly=Core"
    xmlns:converters="clr-namespace:FinanzasApp.UI.Converters"
    x:DataType="vm:NotificacionesViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <!-- Registramos el converter localmente para que funcione dentro del DataTemplate -->
    <ContentPage.Resources>
        <converters:NotificacionColorConverter x:Key="NotificacionColorConverterLocal" />
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverterLocal" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Cabecera -->
        <Grid
            Grid.Row="0"
            BackgroundColor="{StaticResource Primary}"
            ColumnDefinitions="Auto,*,Auto">
            <Grid.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="16,48,16,16" />
                    <On Platform="WinUI" Value="16,16,16,16" />
                </OnPlatform>
            </Grid.Padding>

            <Button
                Grid.Column="0"
                Text="←" FontSize="20"
                BackgroundColor="Transparent"
                TextColor="{StaticResource White}"
                Command="{Binding VolverCommand}" />

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label
                    Text="Notificaciones"
                    FontSize="20" FontAttributes="Bold"
                    TextColor="{StaticResource White}" />
                <Label
                    Text="{Binding TotalNotificaciones, StringFormat='{0} pendientes'}"
                    FontSize="12"
                    TextColor="{StaticResource PrimaryLight}"
                    IsVisible="{Binding TotalNotificaciones,
                        Converter={StaticResource NotNullConverter}}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="🗑"
                FontSize="20"
                BackgroundColor="Transparent"
                TextColor="{StaticResource White}"
                IsVisible="{Binding TotalNotificaciones,
                    Converter={StaticResource NotNullConverter}}"
                Command="{Binding EliminarTodasCommand}" />
        </Grid>

        <!-- Lista -->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding EstaCargando}">

            <CollectionView
                ItemsSource="{Binding Notificaciones}"
                SelectionMode="None"
                Margin="16,8">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:NotificacionDto">
                        <!-- Usamos el converter registrado localmente -->
                        <Border
                            Margin="0,4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="16"
                            BackgroundColor="{Binding Tipo,
                                Converter={StaticResource NotificacionColorConverterLocal}}">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Black}"
                                        Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Icono}"
                                    FontSize="28"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding Titulo}"
                                        FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Text="{Binding Mensaje}"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label
                                        Text="{Binding FechaCreacion,
                                            StringFormat='{0:dd MMM yyyy HH:mm}'}"
                                        FontSize="10"
                                        TextColor="{StaticResource Gray400}"
                                        IsVisible="{Binding EsDinamica,
                                            Converter={StaticResource InvertedBoolConverterLocal}}" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="2"
                                    Text="✕"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Gray400}"
                                    Padding="4"
                                    VerticalOptions="Start"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificacionesViewModel}},
                                        Path=EliminarCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" Padding="0,48">
                        <Label Text="🔔" FontSize="48" HorizontalOptions="Center" />
                        <Label
                            Text="No tienes notificaciones"
                            Style="{StaticResource LabelSecundario}"
                            HorizontalOptions="Center" />
                        <Label
                            Text="Todo está bajo control 👍"
                            Style="{StaticResource LabelSecundario}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>