<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanzasApp.UI.Views.CrearMovimientoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FinanzasApp.UI.ViewModels"
    xmlns:enums="clr-namespace:FinanzasApp.Core.Enums;assembly=Core"
    x:DataType="vm:CrearMovimientoViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Cabecera -->
        <Grid
            Grid.Row="0"
            BackgroundColor="{StaticResource Primary}"
            ColumnDefinitions="Auto,*">

            <Grid.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="16,48,16,16" />
                    <On Platform="WinUI" Value="16,16,16,16" />
                </OnPlatform>
            </Grid.Padding>

            <Button
                Grid.Column="0"
                Text="←"
                FontSize="20"
                BackgroundColor="Transparent"
                TextColor="{StaticResource White}"
                Command="{Binding CancelarCommand}" />

            <Label
                Grid.Column="1"
                Text="Nuevo Movimiento"
                FontSize="20" FontAttributes="Bold"
                TextColor="{StaticResource White}"
                VerticalOptions="Center" />
        </Grid>

        <!-- Formulario -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="0">

                <!-- Error -->
                <Border
                    IsVisible="{Binding HayError}"
                    BackgroundColor="{StaticResource GastoLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    Margin="0,0,0,16">
                    <Label
                        Text="{Binding MensajeError}"
                        TextColor="{StaticResource Gasto}"
                        FontSize="13" />
                </Border>

                <!-- Tipo -->
                <Label Text="Tipo" Style="{StaticResource LabelSecundario}" Margin="0,0,0,8"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,0,0,16">

                    <!-- Botón Gasto -->
                    <Border
                        Grid.Column="0"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{StaticResource Gasto}"
                        Padding="0"
                        BackgroundColor="{Binding EsGasto, Converter={StaticResource EsGastoActivoConverter}}">
                        <Button
                            Text="🔴 Gasto"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Gasto}"
                            FontAttributes="Bold"
                            Command="{Binding SeleccionarTipoGastoCommand}" />
                    </Border>

                    <!-- Botón Ingreso -->
                    <Border
                        Grid.Column="1"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{StaticResource Ingreso}"
                        Padding="0"
                        BackgroundColor="{Binding EsIngreso, Converter={StaticResource EsIngresoActivoConverter}}">
                        <Button
                            Text="💚 Ingreso"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Ingreso}"
                            FontAttributes="Bold"
                            Command="{Binding SeleccionarTipoIngresoCommand}" />
                    </Border>
                </Grid>

                <!-- Nombre -->
                <Label Text="Nombre *" Style="{StaticResource LabelSecundario}" Margin="0,0,0,4"/>
                <Border StrokeThickness="1.5" Stroke="{StaticResource Gray200}"
                        StrokeShape="RoundRectangle 10" Padding="12,0" Margin="0,0,0,16">
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="Ej: Nómina, Supermercado..."
                        Text="{Binding Nombre}"
                        ReturnType="Next" />
                </Border>

                <!-- Cantidad -->
                <Label Text="Cantidad *" Style="{StaticResource LabelSecundario}" Margin="0,0,0,4"/>
                <Border StrokeThickness="1.5" Stroke="{StaticResource Gray200}"
                        StrokeShape="RoundRectangle 10" Padding="12,0" Margin="0,0,0,16">
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="0.00"
                        Text="{Binding Cantidad}"
                        Keyboard="Numeric"
                        ReturnType="Next" />
                </Border>

                <!-- Categoría -->
                <Label Text="Categoría" Style="{StaticResource LabelSecundario}" Margin="0,0,0,4"/>
                <Border StrokeThickness="1.5" Stroke="{StaticResource Gray200}"
                        StrokeShape="RoundRectangle 10" Padding="4,0" Margin="0,0,0,16">
                    <Picker
                        Title="Selecciona una categoría"
                        ItemsSource="{Binding Categorias}"
                        SelectedItem="{Binding CategoriaSeleccionada}"
                        ItemDisplayBinding="{Binding Nombre}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                        TitleColor="{StaticResource Gray400}" />
                </Border>

                <!-- Descripción -->
                <Label Text="Descripción" Style="{StaticResource LabelSecundario}" Margin="0,0,0,4"/>
                <Border StrokeThickness="1.5" Stroke="{StaticResource Gray200}"
                        StrokeShape="RoundRectangle 10" Padding="12,8" Margin="0,0,0,16">
                    <Editor
                        Text="{Binding Descripcion}"
                        Placeholder="Añade una nota opcional..."
                        PlaceholderColor="{StaticResource Gray400}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                        FontSize="15"
                        HeightRequest="80"
                        AutoSize="Disabled" />
                </Border>

                <!-- Etiqueta -->
                <Label Text="Etiqueta" Style="{StaticResource LabelSecundario}" Margin="0,0,0,4"/>
                <Border StrokeThickness="1.5" Stroke="{StaticResource Gray200}"
                        StrokeShape="RoundRectangle 10" Padding="12,0" Margin="0,0,0,24">
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="Ej: trabajo, ocio..."
                        Text="{Binding Etiqueta}" />
                </Border>

                <!-- Botón guardar -->
                <Button
                    Text="Guardar movimiento"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding GuardarCommand}"
                    IsEnabled="{Binding NoEstaCargando}" />

                <ActivityIndicator
                    IsRunning="{Binding EstaCargando}"
                    IsVisible="{Binding EstaCargando}"
                    Color="{StaticResource Primary}"
                    HorizontalOptions="Center"
                    Margin="0,8" />

                <BoxView>
                    <BoxView.HeightRequest>
                        <OnPlatform x:TypeArguments="x:Double">
                            <On Platform="Android" Value="32" />
                            <On Platform="WinUI" Value="16" />
                        </OnPlatform>
                    </BoxView.HeightRequest>
                </BoxView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>